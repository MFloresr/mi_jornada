# Ejemplo de variables de entorno (sin valores reales).
# La aplicación las lee del entorno del sistema: este archivo no se carga solo.
# En local basta con DJANGO_DEBUG=1; el resto es para producción (Vercel).

# Clave secreta de Django (obligatoria en producción). Genera una larga y aleatoria.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# 1 para desarrollo local (sirve los estáticos); en producción no se define.
DJANGO_DEBUG=1

# Conexión a PostgreSQL (por ejemplo, Supabase). Si no se define, se usa SQLite.
DATABASE_URL=

# URL pública de la aplicación, usada en los enlaces de recuperación de contraseña.
FRONTEND_BASE_URL=

# Opcional: dominios propios y orígenes con https, separados por comas.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Correo de recuperación de contraseña (Gmail con contraseña de aplicación).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Asistente de IA. Sin ninguna clave, el asistente no aparece.
# Si están las dos, se usa Gemini.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales del asistente: modelo concreto y usos por usuario y día.
IA_MODELO=
IA_LIMITE_DIARIO=40
# Límite diario propio de la cuenta de demostración.
IA_LIMITE_DEMO=15
